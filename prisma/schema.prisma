generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Role {
  ADMIN
  STAFF
}

enum ServiceCategory {
  MANICURE
  PEDICURE
}

enum ScheduleType {
  WEEKLY
  ROTATING
}

enum ExceptionType {
  UNAVAILABLE
  AVAILABLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  CUSTOMER
  ADMIN
}

enum AuditEntityType {
  USER
  SERVICE
  STAFF
  SCHEDULE
  BOOKING
  SETTINGS
}

model Organization {
  id          String                  @id @default(uuid()) @db.Uuid
  slug        String                  @unique
  name        String
  timezone    String                  @default("Europe/Moscow")
  address     String
  phone       String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  settings    OrganizationSettings?
  memberships Membership[]
  staff       StaffProfile[]
  customers   CustomerProfile[]
  services    Service[]
  addons      ServiceAddon[]
  schedules   SchedulePattern[]
  exceptions  AvailabilityException[]
  bookings    Booking[]
  auditLogs   AuditLog[]
}

model OrganizationSettings {
  organizationId           String       @id @db.Uuid
  minimumLeadMinutes       Int          @default(120)
  bookingHorizonDays       Int          @default(60)
  cancellationLimitMinutes Int          @default(480)
  rescheduleLimitMinutes   Int          @default(480)
  slotStepMinutes          Int          @default(15)
  technicalBreakMinutes    Int          @default(15)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  phone           String           @unique
  passwordHash    String?
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  staffProfile    StaffProfile?
  sessions        Session[]
  accounts        Account[]
  createdBookings Booking[]        @relation("BookingCreatedBy")
  bookingHistory  BookingHistory[]
  auditLogs       AuditLog[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, role])
}

model StaffProfile {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  userId         String                  @unique @db.Uuid
  displayName    String
  slug           String
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  services       StaffService[]
  schedules      SchedulePattern[]
  exceptions     AvailabilityException[]
  bookings       Booking[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
}

model CustomerProfile {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  firstName       String
  lastName        String
  phone           String
  consentAt       DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookings        Booking[]

  @@unique([organizationId, phone])
}

model Service {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  category        ServiceCategory
  name            String
  description     String?
  durationMinutes Int
  priceMinor      Int
  currency        String           @default("RUB")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff           StaffService[]
  bookingItems    BookingService[]

  @@unique([organizationId, name])
  @@index([organizationId, category, isActive])
}

model ServiceAddon {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  name              String
  priceMinor        Int?
  minimumPriceMinor Int?
  isIncluded        Boolean      @default(false)
  affectsDuration   Boolean      @default(false)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
}

model StaffService {
  staffId   String       @db.Uuid
  serviceId String       @db.Uuid
  createdAt DateTime     @default(now())
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model SchedulePattern {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  staffId          String       @db.Uuid
  type             ScheduleType
  dayOfWeek        Int?
  anchorDate       DateTime?    @db.Date
  cycleLengthDays  Int?
  workingCycleDays Int[]
  startMinute      Int
  endMinute        Int
  validFrom        DateTime     @db.Date
  validUntil       DateTime?    @db.Date
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff            StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, validFrom, validUntil])
}

model AvailabilityException {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  staffId        String        @db.Uuid
  type           ExceptionType
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff          StaffProfile  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, startAt, endAt])
}

model Booking {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  customerId         String           @db.Uuid
  staffId            String           @db.Uuid
  createdById        String?          @db.Uuid
  startAt            DateTime
  endAt              DateTime
  occupiedUntil      DateTime
  status             BookingStatus    @default(PENDING)
  source             BookingSource
  totalPriceMinor    Int
  currency           String           @default("RUB")
  customerComment    String?
  internalComment    String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer           CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff              StaffProfile     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdBy          User?            @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  services           BookingService[]
  history            BookingHistory[]
  idempotencyKeys    IdempotencyKey[]

  @@index([organizationId, startAt])
  @@index([staffId, startAt, occupiedUntil])
  @@index([customerId, startAt])
}

model BookingService {
  bookingId               String  @db.Uuid
  serviceId               String  @db.Uuid
  position                Int
  nameSnapshot            String
  durationMinutesSnapshot Int
  priceMinorSnapshot      Int
  booking                 Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service                 Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bookingId, serviceId])
  @@unique([bookingId, position])
}

model BookingHistory {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String   @db.Uuid
  changedById  String?  @db.Uuid
  action       String
  previousData Json?
  newData      Json?
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  changedBy    User?    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

model AuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  userId         String?         @db.Uuid
  action         String
  entityType     AuditEntityType
  entityId       String
  metadata       Json?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  userId      String?  @db.Uuid
  bookingId   String?  @db.Uuid
  requestHash String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
